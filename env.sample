BOT_TOKEN=1234:1234
OPEN_WEATHER_MAP_APP_ID=1234
LOG_LEVEL=INFO
PERSISTENCE_PATH=/data/bot_state.pickle
KOREA_CITY=Seoul
KOREA_SLEEP_START_HOUR=0
KOREA_SLEEP_END_HOUR=8
MIMIMI_REACTION_PROBABILITY=1
PUNISHMENT_REACTION_PROBABILITY=10
STATS_ALERT_MIN_MESSAGES=200
STATS_ALERT_MAX_MESSAGES=300

# Optional: OpenAI-compatible LLM used to pick the exact topic that the
# "let me google that for you" reaction searches. Without an API key the
# reaction falls back to searching the conversation text as-is.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
